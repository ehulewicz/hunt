/archived/neuvidion/backend/**/bin/
/archived/neuvidion/backend/**/obj/

# Python
.venv/
.uv-cache/
.uv-python/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc
.coverage

# Node / build
node_modules/
.next/
*.tsbuildinfo
