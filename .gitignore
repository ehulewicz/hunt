# Secrets / environment
.env
.env.*
!*.example

# Archived Northhealth .NET build output
/archived/neuvidion/backend/**/bin/
/archived/neuvidion/backend/**/obj/

# Python
.venv/
.uv-cache/
.uv-python/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc
.coverage

# Node / build
node_modules/
.next/
*.tsbuildinfo
playwright-report/
test-results/

# Future worker local runtime data
workers/.chrome-profile/
.playwright-mcp/
.logs/

# Resume build intermediary; JSON and PDF in this directory are tracked.
artifacts/resume/*.tex

# Sam Kim reference fixture renders. The fixture JSON is tracked; its build
# output is not, because bin/Sam_Kim_resume_dec2027.pdf is already the tracked
# comparison target and a second near-identical PDF is just noise.
bin/sam-kim.tex
bin/sam-kim.pdf

# Nested standalone repo (github.com/ehulewicz/dotfiles) — cloned here, never
# committed to personal-os
dotfiles/

# Supabase CLI link state is deployment tooling, never product state
database/.branches/
database/.temp/
.vercel
.env*

# Scratch clones used for local exploration, never product state
testing/
.env*.local

# LaTeX build residue beside the canonical resume
artifacts/resume/*.aux
artifacts/resume/*.fdb_latexmk
artifacts/resume/*.fls
artifacts/resume/*.log
artifacts/resume/*.out
artifacts/resume/*.synctex.gz
artifacts/resume/*.tex
